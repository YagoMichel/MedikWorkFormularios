JWT_SECRET=change-me-in-prod-please

# Sincronización del expediente documental a OneDrive (opcional; "none" para
# guardar solo en disco local). Ver backend/.env.example para el paso a paso
# de cómo registrar la app en Microsoft Entra ID y obtener estos valores.
CLOUD_STORAGE_PROVIDER=onedrive
ONEDRIVE_TENANT_ID=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_DRIVE_USER=

# Alternativa ya soportada por el código (no activa mientras CLOUD_STORAGE_PROVIDER=onedrive)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ---- Login social Google/Microsoft (OPCIONAL, config-gated) ----
# Sin definir, los botones no aparecen y /api/auth/oauth/* responde 404.
# Registra en cada consola EXACTAMENTE este redirect_uri:
#   ${APP_URL}/api/auth/oauth/google/callback
#   ${APP_URL}/api/auth/oauth/microsoft/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Microsoft: registro DISTINTO al de OneDrive (este usa flujo delegado auth-code).
# Application (client) ID → CLIENT_ID; Certificates & secrets → New client secret →
# el "Value" → CLIENT_SECRET. Tenant 'common' = cuentas personales + de trabajo.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common

# ---- Correo saliente SMTP (verificación de correo y recuperación de contraseña) ----
# Sin definir, NO falla: el enlace con el token se escribe en el log del servidor.
# Gmail: activa 2FA y genera una "Contraseña de aplicación" en
# https://myaccount.google.com/apppasswords (Gmail rechaza la contraseña normal).
# SMTP_FROM = "Nombre visible <direccion-real@gmail.com>"; Gmail solo envía desde
# la dirección real de la cuenta (para un no-reply@dominio propio se necesita
# Google Workspace + dominio).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Mediwork (no responder) <tu-correo@gmail.com>
