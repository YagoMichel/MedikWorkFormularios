// Prisma schema - Mediwork

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DOCTOR
  AGENT
  PACIENTE
  MASTER
}

enum AppointmentStatus {
  AGENDADA
  CONFIRMADA
  EN_CONSULTA
  ATENDIDA
  CANCELADA
  NO_ASISTIO
}

enum AppointmentType {
  PRIMERA_VEZ
  SEGUIMIENTO
  REVISION_LENTES
  URGENCIA
  EMPRESARIAL
}

enum AppointmentSource {
  MANUAL
  AGENT
}

enum PrescriptionType {
  LEJOS
  CERCA
  BIFOCAL
  PROGRESIVO
}

enum PrescriptionStatus {
  ACTIVA
  VENCIDA
  USADA
}

enum MovementType {
  ENTRADA
  SALIDA
  AJUSTE
}

enum SaleStatus {
  PAGADA
  PENDIENTE_ENTREGA
  ENTREGADA
  CANCELADA
  PENDIENTE
  LIQUIDADA
}

enum PaymentMethod {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  COMBINADO
  DEPOSITO
}

enum BatchStatus {
  BORRADOR
  CONFIRMADO
  EN_PROCESO
  CERRADO
  CANCELADO
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  fullName      String
  role          Role
  photoUrl      String?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  appointments  Appointment[]  @relation("DoctorAppointments")
  prescriptions Prescription[] @relation("DoctorPrescriptions")
  sales         Sale[]         @relation("VendorSales")
  abonos        Abono[]        @relation("UserAbonos")
  movements     Movement[]
  uploadedDocuments Document[]
}

model Patient {
  id            String         @id @default(cuid())
  fullName      String
  birthDate     DateTime?
  gender        String?
  phone         String?
  email         String?
  address       String?
  nss           String?
  // Texto libre legacy (se conserva para retrocompatibilidad)
  company       String?
  // FK canonica
  companyId     String?
  companyRel    Company?       @relation(fields: [companyId], references: [id])
  // Perfil de empresa (checklist de estudios requeridos) asignado a mano
  companyProfileId String?
  companyProfile    CompanyProfile? @relation(fields: [companyProfileId], references: [id])
  medicalNotes  String?
  photoUrl      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  appointments  Appointment[]
  prescriptions Prescription[]
  sales         Sale[]
  surveys       PatientSurvey[]
  medicalExams  MedicalExam[]
  documents     Document[]

  @@index([companyId])
  @@index([nss])
}

// Checklist de estudios requeridos por empresa + perfil (ej. Sandvik →
// "Técnico plomo" → Laboratorio, Radiografía, Ruffier, ...). Importado desde
// PERFILES.xlsx vía prisma/seed-perfiles.ts.
model CompanyProfile {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  items     CompanyProfileItem[]
  patients  Patient[]

  @@index([companyId])
}

model CompanyProfileItem {
  id        String         @id @default(cuid())
  profileId String
  profile   CompanyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  label     String
  detail    String?        // texto de referencia (ej. qué análisis incluye el laboratorio)
  order     Int

  @@index([profileId])
}

model MedicalExam {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())

  agudezaVisual Json?  // { od, oi, ambos, cercana } cada uno { sinLentes, conLentes, recuperacion }
  opcionesLentes Json? // { seguridad, usoDiario, ambos, actualizacion, fotosensible, cirugias, astigmatismo, miopia, hipermetropia, presbicia, pterigionOd, pterigionOi, lubricante, campimetria, campimetriaAst, rejilla, ishihara, errores, haceUsoLentes, ultimaActualizacion, otros }
  signosVitales Json? // { peso, talla, imc, ta, fc, fr, temperatura, sao2, cintura, cadera, torax, imcClasificacion }
  antGineco     Json? // { menarca, fum, ritmo, ivs, g, p, c, a, fup, mpf, pap, its, otros }
  antAndro      Json? // { espermaquia, ivs, hijosMujeres, hijosHombres, mpf, psa, its, otros }
  riesgoCardio  Json? // { hdl, colesterol, edadCv, porcentajeRiesgo, riesgo }
  examenes      Json? // { audiometria, espirometria, otoscopia, dientes, otros, tiempo }
  ruffier       Json? // { reposo{p,r}, esfuerzo{p,r}, minuto{p,r}, calificacion }
  rayosX        Json? // { ic, anterior, sagital, ferguson, lordotico, coob, dismetria, l3, hallazgos }

  recibeRadiografias   String?
  fechaRadiografias    String?
  indicacionesConocidas Boolean?
  notas                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
}

enum DocumentType {
  CUESTIONARIO
  RESULTADOS
  CONSENTIMIENTO
  OTRO
}

// Expediente documental del paciente (cuestionario, resultados, hoja de
// consentimiento, etc.). El archivo en sí vive en almacenamiento externo
// (hoy disco local, a futuro OneDrive) — aquí solo se registra la referencia
// para poder filtrar/buscar desde el sistema sin depender de cómo estén
// organizadas las carpetas ahí.
model Document {
  id           String       @id @default(cuid())
  patientId    String
  patient      Patient      @relation(fields: [patientId], references: [id])
  type         DocumentType
  visitDate    DateTime     @default(now())
  fileName     String
  fileUrl      String
  uploadedById String?
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime     @default(now())
  cloudProvider String?     // "google" | "onedrive" — null si no se sincronizó
  cloudFileId   String?
  cloudWebUrl   String?

  @@index([patientId])
  @@index([visitDate])
}

model Appointment {
  id          String            @id @default(cuid())
  patientId   String?
  patient     Patient?          @relation(fields: [patientId], references: [id])
  doctorId    String
  doctor      User              @relation("DoctorAppointments", fields: [doctorId], references: [id])
  date        DateTime
  durationMin Int               @default(30)
  type        AppointmentType   @default(PRIMERA_VEZ)
  status      AppointmentStatus @default(AGENDADA)
  source      AppointmentSource @default(MANUAL)
  batchId     String?
  batch       CompanyBatch?     @relation(fields: [batchId], references: [id])
  color       String?
  preNotes    String?
  postNotes   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([date])
  @@index([batchId])
}

model Prescription {
  id              String             @id @default(cuid())
  patientId       String
  patient         Patient            @relation(fields: [patientId], references: [id])
  doctorId        String
  doctor          User               @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
  issuedAt        DateTime           @default(now())
  expiresAt       DateTime
  odSph           Float?
  odCyl           Float?
  odAxis          Float?
  odAdd           Float?
  oiSph           Float?
  oiCyl           Float?
  oiAxis          Float?
  oiAdd           Float?
  dpOd            Float?
  dpOi            Float?
  dpBin           Float?
  type            PrescriptionType   @default(LEJOS)
  diagnosis       String?
  recommendations String?
  status          PrescriptionStatus @default(ACTIVA)
  imageUrl        String?
  sales           Sale[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model Company {
  id          String         @id @default(cuid())
  name        String         @unique
  contactName String?
  phone       String?
  email       String?
  address     String?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  patients    Patient[]
  batches     CompanyBatch[]
  profiles    CompanyProfile[]
}

model Category {
  id       String     @id @default(cuid())
  name     String     @unique
  parentId String?
  parent   Category?  @relation("Sub", fields: [parentId], references: [id])
  children Category[] @relation("Sub")
  products Product[]
}

model Product {
  id             String     @id @default(cuid())
  sku            String     @unique
  name           String
  description    String?
  categoryId     String
  category       Category   @relation(fields: [categoryId], references: [id])
  brand          String?
  costPrice      Float      @default(0)
  salePrice      Float      @default(0)
  stock          Int        @default(0)
  minStock       Int        @default(0)
  attributes     Json?
  imageUrl       String?
  supplier       String?
  lastMovementAt DateTime?
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  movements      Movement[]
  saleItems      SaleItem[]
}

model Movement {
  id        String       @id @default(cuid())
  type      MovementType
  productId String
  product   Product      @relation(fields: [productId], references: [id])
  quantity  Int
  unitCost  Float?
  reason    String?
  reference String?
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now())
}

model Sale {
  id                 String         @id @default(cuid())
  folio              String         @unique
  patientId          String?
  patient            Patient?       @relation(fields: [patientId], references: [id])
  prescriptionId     String?
  prescription       Prescription?  @relation(fields: [prescriptionId], references: [id])
  vendorId           String
  vendor             User           @relation("VendorSales", fields: [vendorId], references: [id])
  items              SaleItem[]
  subtotal           Float          @default(0)
  discount           Float          @default(0)
  tax                Float          @default(0)
  total              Float          @default(0)
  deposit            Float          @default(0)
  balance            Float          @default(0)
  paymentMethod      PaymentMethod  @default(EFECTIVO)
  depositMethod      PaymentMethod?
  finalPaymentMethod PaymentMethod?
  abonos             Abono[]
  lensType           String?
  lensEye            String?
  pd                 String?
  odEsf              String?
  odCil              String?
  odEje              String?
  odAdd              String?
  oiEsf              String?
  oiCil              String?
  oiEje              String?
  oiAdd              String?
  referralHospital   String?
  status             SaleStatus     @default(PAGADA)
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  discount  Float   @default(0)
  subtotal  Float
}

model Abono {
  id        String        @id @default(cuid())
  saleId    String
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount    Float
  method    PaymentMethod @default(EFECTIVO)
  notes     String?
  userId    String
  user      User          @relation("UserAbonos", fields: [userId], references: [id])
  createdAt DateTime      @default(now())
}

// =========================================================
// MODELOS NUEVOS PARA AGENTE
// =========================================================

/// Cupo de pacientes por dia. Si no existe registro, se usa default 20.
model DayCapacity {
  id          String   @id @default(cuid())
  date        DateTime @unique
  maxPatients Int      @default(20)
  blocked     Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Jornada empresarial: bloque de citas del mismo dia para una empresa.
model CompanyBatch {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  date          DateTime
  expectedCount Int           @default(0)
  status        BatchStatus   @default(BORRADOR)
  contactName   String?
  contactPhone  String?
  contactEmail  String?
  notes         String?
  // sessionId del chat que origino el batch, opcional
  sessionId     String?
  appointments  Appointment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([companyId])
  @@index([date])
  @@index([status])
}

/// Conversacion del agente con un cliente externo (WhatsApp / Gmail).
model Conversation {
  id         String                @id @default(cuid())
  channel    String                // "whatsapp" | "gmail"
  externalId String                // numero de telefono o email
  state      String                @default("active") // active | resolved
  context    Json?                 // metadata libre (empresa_id, batch_id en curso, etc.)
  messages   ConversationMessage[]
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@unique([channel, externalId])
  @@index([state])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String       // user | assistant | tool_result
  content        Json         // texto o bloque de tool_use / tool_result
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model PatientSurvey {
  id        String   @id @default(cuid())
  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id])

  // Encabezado
  empresa     String?
  tipoExamen  String?   // Ingreso | Periodico | Otro
  otroTipo    String?
  actividades String?

  // Datos personales
  nombre          String
  edad            Int?
  tipoSangre      String?
  puestoDeTrabajo String?
  celular         String?
  nss             String?
  fechaNacimiento String?
  escolaridad     String?
  estadoCivil     String?
  lugarNacimiento String?
  correo          String?

  // Domicilio
  calle     String?
  numero    String?
  colonia   String?
  municipio String?
  cp        String?

  // Hábitos — actividad física
  practicaDeporte   Boolean?
  cualDeporte       String?
  frecuenciaDeporte String?  // Diario | 3-4 veces/sem | 1-2 veces/sem | Fines de semana
  horasDeporte      String?

  // Hábitos — alimentación
  habitosAlimenticios   String?  // Bueno | Regular | Malo
  comidasDia            String?  // 1-2 | 3 | 4-5 | Más de 5
  consumeFrutasVerduras String?  // Diario | Frecuente | Poco | Nunca
  aguaDia               String?  // Menos de 1L | 1-2L | 2-3L | Más de 3L

  // Hábitos — sueño
  calidadSueno     String?  // Bueno | Regular | Malo
  horasSueno       String?  // Menos de 5h | 5-6h | 7-8h | Más de 8h
  especifiqueSueno String?

  // Tabaquismo
  fuma           String?  // SI | NO | EXFUMADOR
  edadInicioFuma String?
  anosFumando    String?
  cigarrosDia    String?

  // Alcoholismo
  consumeAlcohol    Boolean?
  tipoBebida        String?
  cantidadBebidas   String?
  frecuenciaAlcohol String?  // Todos los días | Cada fin de semana | Cada 15 días | Cada mes | 1 o 2 veces al año

  // Drogas
  consumeDrogas   String?  // NO_NUNCA | SI_CONSUMO | CONSUMI
  cualDroga       String?
  frecuenciaDroga String?
  tiempoDroga     String?
  ultimaVezDroga  String?

  // Vacunación / otros
  esquemaVacunacion Boolean?
  dosisAnticovid    String?
  marcaVacuna       String?
  tieneTatuajes     Boolean?
  ultimoTatuaje     String?
  usaAudifonos      Boolean?

  // Antecedentes familiares JSON: [{enfermedad, si, quien}]
  antecedentesFamiliares Json?

  // Laborales
  edadInicioLaboral String?
  trabajoMinas      Boolean?
  tiempoMinas       String?
  exposiciones      Json?   // {ruidos, polvos, vapores, humos, riesgoElectrico, usaEpp}
  historialEmpleos  Json?   // [{empresa, cargo, tiempo, exponentes}]

  // Antecedentes patológicos JSON: [{condicion, si, especifique}]
  antecedentesPatologicos Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
}
