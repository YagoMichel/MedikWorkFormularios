DATABASE_URL=postgresql://mediwork:mediwork@db:5432/mediwork?schema=public
JWT_SECRET=cambia-esto-en-produccion
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...
DEFAULT_DAILY_CAPACITY=20
CLINIC_NAME=Mi Clínica
CLINIC_ADDRESS=
CLINIC_PHONE=
CLINIC_HOURS_WEEKDAY=09:00-18:00
CLINIC_HOURS_SATURDAY=09:00-14:00
# WhatsApp ya no está en el sistema — está en mediwork-bot
# SELF_URL: URL de este mismo servicio (para que el agente chat web se llame a sí mismo)
SELF_URL=http://localhost:4000
PORT=4000
TZ=America/Mexico_City

# Sincronización del expediente documental a la nube (opcional).
# Sin configurar (o "none"), el sistema guarda solo en disco local.
CLOUD_STORAGE_PROVIDER=onedrive

# Requeridas si CLOUD_STORAGE_PROVIDER=onedrive — app registrada en Microsoft
# Entra ID (antes "Azure Active Directory") del tenant de OneDrive/Microsoft 365
# Business, usando client-credentials (app-only, sin usuario que inicie sesión).
# Pasos en https://portal.azure.com (necesitas ser Global Admin o que alguien con
# ese rol otorgue el consentimiento del paso 4):
#   1. Microsoft Entra ID → App registrations → New registration.
#      "Supported account types" = solo esta organización (single tenant).
#   2. En el Overview de la app recién creada: copia "Application (client) ID"
#      → ONEDRIVE_CLIENT_ID, y "Directory (tenant) ID" → ONEDRIVE_TENANT_ID.
#   3. Certificates & secrets → New client secret → copia el "Value" al toque
#      (solo se muestra una vez) → ONEDRIVE_CLIENT_SECRET. Ojo: caduca (elige
#      12-24 meses) y hay que regenerarlo antes de que expire.
#   4. API permissions → Add a permission → Microsoft Graph → "Application
#      permissions" (NO "Delegated") → busca "Files" → marca Files.ReadWrite.All
#      → Add permissions → botón "Grant admin consent for <organización>".
#   5. ONEDRIVE_DRIVE_USER = correo de la cuenta cuyo OneDrive va a usarse
#      (ej. la cuenta de la clínica). Esa cuenta debe haber entrado al menos
#      una vez a onedrive.com para que Microsoft le aprovisione el Drive.
ONEDRIVE_TENANT_ID=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_DRIVE_USER=

# Alternativa ya soportada por el código pero no activa (CLOUD_STORAGE_PROVIDER
# arriba está en "onedrive"): Google Drive vía OAuth2 como dueño de la cuenta
# (NO cuenta de servicio: esas no tienen cuota propia y no pueden escribir en
# una carpeta de Drive personal). Client ID/Secret salen de un OAuth Client tipo
# "Web application" en Google Cloud Console; el refresh token se obtiene una
# vez vía https://developers.google.com/oauthplayground
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
