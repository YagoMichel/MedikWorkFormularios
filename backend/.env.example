DATABASE_URL=postgresql://mediwork:mediwork@db:5432/mediwork?schema=public
# OBLIGATORIO en producción (NODE_ENV=production): el servidor no arranca sin él.
# Genera uno largo y aleatorio, ej.: openssl rand -base64 48
JWT_SECRET=cambia-esto-en-produccion

# Duración de la sesión (formato de jsonwebtoken: '12h', '8h', '1d'). Sin
# definir = 12h. Sistema con datos sensibles de salud → sesiones acotadas
# (LFPDPPP/NOM-024). Se complementa con auto-logout por inactividad en el
# frontend (VITE_INACTIVITY_MIN, default 30 min).
# SESSION_TTL=12h

# Número EXACTO de proxies confiables delante del backend (para que req.ip sea
# la IP real del cliente en rate limits y bitácora). Sin definir = 1.
#   1 = el nginx del contenedor es el borde (local/dev)
#   2 = hay un reverse proxy del host (nginx/Caddy) delante del nginx del contenedor
# NO lo subas "por si acaso": un valor mayor al real permite falsear la IP con
# un header X-Forwarded-For inventado. Con Cloudflare se usa CF-Connecting-IP.
# TRUST_PROXY_HOPS=1

# Orígenes permitidos para CORS, separados por comas. Sin definir = cualquier
# origen (solo aceptable en desarrollo local).
# CORS_ORIGIN=https://clinica.mediworkzac.com

# Captcha Cloudflare Turnstile (anti-bots en login y encuesta pública).
# Gratis en https://dash.cloudflare.com → Turnstile → Add site.
# Sin definir, el captcha queda desactivado (los rate limits siguen activos).
# La clave pública (site key) va en el frontend: VITE_TURNSTILE_SITE_KEY.
# TURNSTILE_SECRET_KEY=

# URL pública de la app (frontend) — se usa para armar los enlaces de los
# correos (activación de empresa, verificación de paciente).
APP_URL=http://localhost:3000

# Envío de correo (SMTP). Sin configurar, el sistema NO falla: deja el enlace
# de activación/verificación en el log del servidor para copiarlo a mano.
# Ejemplo con un proveedor tipo SendGrid/Resend/Gmail SMTP:
# SMTP_HOST=smtp.tuproveedor.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Mediwork <no-reply@tudominio.com>

# ---- Login social Google/Microsoft (OPCIONAL, config-gated) ----
# Sin definir, el login social queda dormido: los botones no aparecen y las
# rutas /api/auth/oauth/* responden 404. La app funciona igual con contraseña.
# En cada consola registra EXACTAMENTE este redirect_uri:
#   ${APP_URL}/api/auth/oauth/google/callback
#   ${APP_URL}/api/auth/oauth/microsoft/callback
# Google:  https://console.cloud.google.com → APIs y servicios → Credenciales →
#          "ID de cliente de OAuth" (tipo Aplicación web).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Microsoft: https://portal.azure.com → Microsoft Entra ID → Registros de app.
#   OJO: es un registro DISTINTO al de OneDrive (aquel es app-only; este necesita
#   el flujo delegado auth-code). Tenant 'common' = cuentas personales + de trabajo.
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_TENANT=common

GOOGLE_API_KEY=AIza...
DEFAULT_DAILY_CAPACITY=20
CLINIC_NAME=Mi Clínica
CLINIC_ADDRESS=
CLINIC_PHONE=
CLINIC_HOURS_WEEKDAY=09:00-18:00
CLINIC_HOURS_SATURDAY=09:00-14:00
# WhatsApp ya no está en el sistema — está en mediwork-bot
# SELF_URL: URL de este mismo servicio (para que el agente chat web se llame a sí mismo)
SELF_URL=http://localhost:4000
PORT=4000
TZ=America/Mexico_City

# Sincronización del expediente documental a la nube (opcional).
# Sin configurar (o "none"), el sistema guarda solo en disco local.
CLOUD_STORAGE_PROVIDER=onedrive

# Requeridas si CLOUD_STORAGE_PROVIDER=onedrive — app registrada en Microsoft
# Entra ID (antes "Azure Active Directory") del tenant de OneDrive/Microsoft 365
# Business, usando client-credentials (app-only, sin usuario que inicie sesión).
# Pasos en https://portal.azure.com (necesitas ser Global Admin o que alguien con
# ese rol otorgue el consentimiento del paso 4):
#   1. Microsoft Entra ID → App registrations → New registration.
#      "Supported account types" = solo esta organización (single tenant).
#   2. En el Overview de la app recién creada: copia "Application (client) ID"
#      → ONEDRIVE_CLIENT_ID, y "Directory (tenant) ID" → ONEDRIVE_TENANT_ID.
#   3. Certificates & secrets → New client secret → copia el "Value" al toque
#      (solo se muestra una vez) → ONEDRIVE_CLIENT_SECRET. Ojo: caduca (elige
#      12-24 meses) y hay que regenerarlo antes de que expire.
#   4. API permissions → Add a permission → Microsoft Graph → "Application
#      permissions" (NO "Delegated") → busca "Files" → marca Files.ReadWrite.All
#      → Add permissions → botón "Grant admin consent for <organización>".
#   5. ONEDRIVE_DRIVE_USER = correo de la cuenta cuyo OneDrive va a usarse
#      (ej. la cuenta de la clínica). Esa cuenta debe haber entrado al menos
#      una vez a onedrive.com para que Microsoft le aprovisione el Drive.
ONEDRIVE_TENANT_ID=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_DRIVE_USER=

# Alternativa ya soportada por el código pero no activa (CLOUD_STORAGE_PROVIDER
# arriba está en "onedrive"): Google Drive vía OAuth2 como dueño de la cuenta
# (NO cuenta de servicio: esas no tienen cuota propia y no pueden escribir en
# una carpeta de Drive personal). Client ID/Secret salen de un OAuth Client tipo
# "Web application" en Google Cloud Console; el refresh token se obtiene una
# vez vía https://developers.google.com/oauthplayground
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
