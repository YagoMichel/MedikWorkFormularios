DATABASE_URL=postgresql://mediwork:mediwork@db:5432/mediwork?schema=public
JWT_SECRET=cambia-esto-en-produccion
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...
DEFAULT_DAILY_CAPACITY=20
CLINIC_NAME=Mi Clínica
CLINIC_ADDRESS=
CLINIC_PHONE=
CLINIC_HOURS_WEEKDAY=09:00-18:00
CLINIC_HOURS_SATURDAY=09:00-14:00
# WhatsApp ya no está en el sistema — está en mediwork-bot
# SELF_URL: URL de este mismo servicio (para que el agente chat web se llame a sí mismo)
SELF_URL=http://localhost:4000
PORT=4000
TZ=America/Mexico_City

# Sincronización del expediente documental a la nube (opcional).
# Sin configurar (o "none"), el sistema sigue guardando solo en disco local.
CLOUD_STORAGE_PROVIDER=none

# Requeridas si CLOUD_STORAGE_PROVIDER=google — OAuth como el dueño de la cuenta
# de Drive (NO cuenta de servicio: las cuentas de servicio no tienen cuota propia
# y no pueden escribir en una carpeta de Drive personal). Client ID/Secret salen
# de un OAuth Client tipo "Web application" en Google Cloud Console; el refresh
# token se obtiene una vez vía https://developers.google.com/oauthplayground
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Requeridas si CLOUD_STORAGE_PROVIDER=onedrive (app registrada en Microsoft Entra ID,
# con permiso de aplicación Files.ReadWrite.All y consentimiento de admin otorgado)
ONEDRIVE_TENANT_ID=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_DRIVE_USER=
